#!/bin/sh
# Same check as pre-commit, for merge commits (which skip the pre-commit hook).
# Enabled per clone with: git config core.hooksPath scripts/hooks
root=$(git rev-parse --show-toplevel) || exit 2
if command -v py >/dev/null 2>&1; then
  exec py -3 "$root/scripts/privacy_guard.py" --staged
elif command -v python3 >/dev/null 2>&1; then
  exec python3 "$root/scripts/privacy_guard.py" --staged
else
  exec python "$root/scripts/privacy_guard.py" --staged
fi
